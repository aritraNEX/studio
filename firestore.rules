
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: Can read their own user data.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId;
    }

    // Projects: Users can only CUD their own projects.
    match /projects/{projectId} {
      allow read, create, update, delete: if request.auth.uid == request.resource.data.userId;
    }

    // Workspaces: Can be read by anyone (for sharing), but only updated/created by the owner.
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow create, update: if request.auth.uid == request.resource.data.ownerId;
      allow delete: if false; // Disallow deletion for now to prevent abuse
    }
  }
}
