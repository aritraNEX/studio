
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read and write to their own user document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A user can read a workspace if they are a member.
    // They can only update it if they are an Owner or Editor.
    // They can only delete it if they are the Owner.
    match /workspaces/{workspaceId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids[request.auth.uid] == true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.members[request.auth.uid].role in ['Owner', 'Editor']);
      allow delete: if request.auth != null && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // A user can read/write tasks if they are a member of the workspace.
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.memberUids[request.auth.uid] == true;
    }

    // Invites can be read by anyone with the link, but only created by authenticated users.
    // Deletion is handled by backend logic (or transactions) when an invite is accepted.
    match /invites/{inviteId} {
      allow read: true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null; // Allows for deletion upon acceptance.
    }
    
    // Legacy projects collection rules.
    match /projects/{projectId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
