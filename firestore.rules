
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users can read their own data.
      // They can create their user document.
      // They can ONLY update the `hasUsedTrial` field, but cannot set `isPremium`.
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium']));
    }
    
    match /projects/{projectId} {
      // Users can read, write, and delete their own projects.
      allow read, write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    match /workspaces/{workspaceId} {
      // Anyone can read a shared workspace.
      allow read;
      // Only the owner can create or update their own workspace.
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      // No one can delete a workspace from the client to prevent accidental data loss.
      allow delete: if false;
    }
  }
}
