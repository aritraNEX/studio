rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to only read, write, and list their own projects.
    match /projects/{projectId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null && request.query.where.get("userId") == request.auth.uid;
    }

    // Workspaces can be read by anyone with the link, but only created/updated by authenticated users.
    // The owner is the only one who can delete it.
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
