rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      // Allow users to read, create, and update their own projects.
      allow read, create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Allow list queries only when filtered by the user's own ID.
      allow list: if request.auth != null && request.query.resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
        // Users can create, read, update, and delete their own tasks.
        allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
        // Allow users to list their own tasks.
        allow list: if request.auth != null && request.auth.uid == request.query.resource.data.userId;
    }

    match /workspaces/{workspaceId} {
      // The person who created it can write to it.
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Anyone can read it (for sharing).
      allow read: if true;
    }
  }
}
