
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write to their own profile.
    // This is crucial for creating the user document on first login.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Groups can be read or written to only by their members.
    // The `memberIds` array is used for efficient security rule checks.
    match /groups/{groupId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.memberIds;
    }
    
    // Projects can be accessed by their owner, or by members of the group they belong to.
    match /projects/{projectId} {
      // Allow read/write if the user is the owner (for personal projects)
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Also allow read/write if the project has a groupId and the user is a member of that group
      allow read, write: if request.auth != null && resource.data.groupId != null &&
                         request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds;
    }
    
    // Task plans are private to each user.
    match /task_plans/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
