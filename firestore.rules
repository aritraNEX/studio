rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own user document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Users can only read, write, and delete their own projects
    match /projects/{projectId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Allow users to create projects if they are logged in
    match /projects/{projectId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Workspaces can be read by anyone, but only written by the owner
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Allow users to create workspaces if they are logged in
    match /workspaces/{workspaceId} {
       allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
