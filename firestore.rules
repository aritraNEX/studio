rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can only read/write/list their own projects.
    match /users/{userId}/projects/{projectId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // Allow a user to list the projects that belong to them.
    match /users/{userId}/projects {
       allow list: if request.auth.uid == userId;
    }

    // A user can create a workspace.
    // Anyone can read a workspace to allow for sharing.
    // Only the owner can update a workspace.
    match /workspaces/{workspaceId} {
      allow create: if request.auth.uid != null;
      allow read: if true;
      allow update: if request.auth.uid == resource.data.ownerId;
    }
  }
}
