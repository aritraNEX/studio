rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection rules
    match /projects/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Tasks collection rules
    match /tasks/{taskId} {
      // Users can read, update, and delete their own tasks.
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Users can create a new task if the 'userId' in the new document matches their own UID.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Workspaces collection rules
    match /workspaces/{workspaceId} {
      // Anyone with the link can read a workspace.
      allow read: if true;
      // Only the owner can write to the workspace.
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
