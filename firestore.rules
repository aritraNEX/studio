
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write to their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A user can create, read, update, and delete their own projects.
    // They cannot access projects belonging to other users.
    match /projects/{projectId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Group related rules
    match /groups/{groupId} {
      // Allow read access if the user's ID is in the `memberIds` array.
      allow read: if request.auth != null && resource.data.memberIds.hasAny([request.auth.uid]);
      
      // Allow creation if the user is authenticated and is the owner.
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      
      // Allow updates (like adding/removing members or changing the name) only by the owner.
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      
      // Allow deletion only by the owner.
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
