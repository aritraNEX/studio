
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Shared workspaces can be read by anyone with the link, 
    // but only created/updated by the authenticated owner.
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // A user can read and write to their own 'projects' subcollection.
    // This allows them to save and load their own work from the dashboard.
    match /users/{userId}/projects/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
