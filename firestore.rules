
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read/write their own profile
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // A user can access a project if they are a participant.
    match /projects/{projectId} {
       allow read, create: if request.auth != null;
       allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // A user can only access their own task plan
    match /task_plans/{userId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Tool metadata can be read by anyone, but only written by admins (not implemented, so effectively read-only)
    match /vesperTools/{toolId} {
      allow read: if true;
      allow write: if false; 
    }

    // Suggestions are private to each user
    match /tool_suggestions/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
