
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
        allow read: if true;
        allow write: if request.auth.uid == resource.data.ownerId;
    }
    match /projects/{projectId} {
      // Allow individual read/write/delete only if the user is the owner
      allow read, delete, update: if request.auth.uid == resource.data.userId;
      
      // Allow users to create new projects
      allow create: if request.auth.uid != null;
      
      // Allow users to list (query) projects if they are logged in.
      // The client-side query ensures they only fetch their own projects.
      allow list: if request.auth.uid != null;
    }
  }
}
