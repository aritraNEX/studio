
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /projects/{projectId} {
      // Allow users to read, create, update, and delete their own projects.
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow a user to list (query) only their own projects.
      allow list: if request.auth != null && request.query.where.path == "userId" && request.query.where.op == "==" && request.query.where.value == request.auth.uid;
    }

    // Allow public read for workspaces, but only owner can write
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
