
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, update, delete: if isUserAuthenticated() && request.auth.uid == userId;
      allow create: if isUserAuthenticated() && request.auth.uid == userId;

      match /projects/{projectId} {
        allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
      }
      
      match /tasks/{taskId} {
         allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
      }
    }
    
    match /NEW users/{userId} {
        allow read, write: if isUserAuthenticated() && request.auth.uid == userId;
    }

    match /workspaces/{workspaceId} {
      allow read: if isUserAuthenticated() && resource.data.memberUids[request.auth.uid] == true;
      allow create: if isUserAuthenticated();
      allow update: if isUserAuthenticated() && request.auth.uid == resource.data.ownerId;
      
      match /members/{memberId} {
         allow read: if isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids[request.auth.uid] == true;
         allow write: if isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
      }

      match /messages/{messageId} {
        allow read, write: if isUserAuthenticated() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberUids[request.auth.uid] == true;
      }
    }

    match /invites/{inviteId} {
        allow read: if isUserAuthenticated();
        allow create: if isUserAuthenticated();
        allow delete: if isUserAuthenticated();
    }
  }
}
