rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read, write, and delete their own projects.
    // They can also list projects filtered by their userId.
    match /projects/{projectId} {
      allow read, list: if request.auth != null && (
        (resource == null && request.query.where.userId == request.auth.uid) ||
        (resource.data.userId == request.auth.uid)
      );
      allow create, update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Allow anyone to read shared workspaces, but only the owner can write.
    match /workspaces/{workspaceId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Allow users to manage their own tasks.
    match /tasks/{taskId} {
      allow read, list: if request.auth != null && (
        (resource == null && request.query.where.userId == request.auth.uid) ||
        (resource.data.userId == request.auth.uid)
      );
      allow create, update, delete: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
