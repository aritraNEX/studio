
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for user projects
    match /projects/{projectId} {
      // Allow users to read, write, and delete their own projects
      allow read, write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow a user to list their own projects, but not others'
      allow list: if request.auth != null && request.auth.uid == request.query.where.userId;
    }
    
    // Rules for shared workspaces
    match /workspaces/{workspaceId} {
        // Only the owner can create or update their workspace document.
        allow write: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
        
        // Anyone with the link can read a shared workspace.
        allow read: if true;
    }
  }
}
