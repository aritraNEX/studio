rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Workspaces
    match /workspaces/{workspaceId} {
      // Anyone can view a workspace if they have the link
      allow read: if true;
      
      // An authenticated user can create a workspace if they are the owner
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;

      // Any authenticated user can update a workspace for collaboration
      allow update: if request.auth != null;
      
      // Only the owner can delete their workspace
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
