
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- USERS ---
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    match /invites/{inviteId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null; // Deletion happens in a transaction
    }

    // --- WORKSPACES ---
    match /workspaces/{workspaceId} {
      allow read: if request.auth != null && exists(path('/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)'));
      allow create: if request.auth != null;
      allow update, delete: if get(path('/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)')).data.role == 'admin';

      match /members/{memberId} {
        allow read: if request.auth != null && exists(path('/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)'));
        allow create, update, delete: if get(path('/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)')).data.role == 'admin';
      }

      match /tasks/{taskId} {
        allow read, create: if request.auth != null && exists(path('/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)'));
        allow update, delete: if get(path('/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)')).data.role in ['admin', 'editor'];
      }
    }
  }
}
