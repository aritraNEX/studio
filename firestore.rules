rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared Workspaces: Allow read for anyone, write only for owner
    match /workspaces/{workspaceId} {
      allow read;
      allow write: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // User Projects:
    match /projects/{projectId} {
      // Allow users to read, write, and delete their own projects.
      allow read, write, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Allow users to list their own projects from the collection.
    // This rule is secured by the query in the application code, which must
    // include a `where('userId', '==', request.auth.uid)` clause.
    match /projects/{projectId} {
       allow list: if request.auth != null && request.query.resource.data.userId == request.auth.uid;
    }
  }
}
