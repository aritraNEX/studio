
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only manage their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only manage their own projects
    match /projects/{projectId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Workspaces can be read by anyone, but only created and updated by the owner.
    // Deletion is disallowed to prevent abuse of shared links.
    match /workspaces/{workspaceId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
        allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
        allow delete: if false;
    }
  }
}
