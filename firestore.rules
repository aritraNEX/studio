
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read for shared workspaces
    match /workspaces/{workspaceId} {
      allow read;
      allow update: if request.auth != null;
    }

    // Projects can be created by any authenticated user
    match /projects/{projectId} {
      // Allow create if the user is logged in and the new document's userId matches their own.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow read and update only by the user who owns the project.
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;

      // Prevent deletion for now to avoid accidental data loss.
      allow delete: if false;
    }
    
    // This rule allows a user to query the 'projects' collection,
    // but ONLY if their query includes `where('userId', '==', request.auth.uid)`.
    // This is crucial for the dashboard page to work correctly and securely.
    match /projects/{projectId} {
       allow list: if request.auth != null && request.query.resource.data.userId == request.auth.uid;
    }
  }
}
