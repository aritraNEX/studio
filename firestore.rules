rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read and write their own profile.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // A user can read/write a group doc if they are a member.
    // They can only delete if they are the owner.
    match /groups/{groupId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null;
    }

    // Projects can be personal or belong to a group.
    match /projects/{projectId} {
      // Allow read/write if the user is the direct owner (personal project)
      // OR if the project belongs to a group and the user is a member of that group.
      allow read, write: if request.auth != null && (
        (resource.data.groupId == null && request.auth.uid == resource.data.userId) ||
        (resource.data.groupId != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds)
      );
      
      // Allow create for any authenticated user.
      allow create: if request.auth != null;
      
      // Allow delete if user is owner, or if it's a group project and user is group owner/editor.
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (
          resource.data.groupId != null &&
          (get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.filter(mem => mem.uid == request.auth.uid && (mem.role == 'Owner' || mem.role == 'Editor')).size() > 0)
        )
      );
    }
    
    // Users can only access their own task plans.
    match /task_plans/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
