rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only create, read, and update their own user document.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
    }

    // A group can be read by its members.
    // It can only be updated by the owner.
    match /groups/{groupId} {
      allow read: if request.auth != null && resource.data.memberIds.hasAny([request.auth.uid]);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Projects can be read by their owner or members of the group it belongs to.
    // It can be written by the owner or an editor/owner of the group.
    match /projects/{projectId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (resource.data.groupId != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds.hasAny([request.auth.uid]))
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (resource.data.groupId != null && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.members.exists(m, m.uid == request.auth.uid && m.role in ['Owner', 'Editor']))
      );
    }
    
    // Task plans can be read and written only by the assigned user.
    match /task_plans/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
